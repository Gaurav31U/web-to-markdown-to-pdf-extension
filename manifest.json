{
  "manifest_version": 3,
  "name": "MarkPDF - Element to Markdown & PDF",
  "version": "1.0.0",
  "description": "Extract any webpage element or article to clean Markdown, customize styles, and export as professional vector PDF documents.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "MarkPDF",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "content/picker.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}

